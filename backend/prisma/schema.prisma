generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_ADMIN")
}

model TipoAusencia {
  idTipoAusencia     Int          @id @default(autoincrement()) @map("id_tipo_ausencia")
  codigo             String       @unique @db.VarChar(5)
  descricao          String       @db.VarChar(200)
  impactaAbsenteismo Boolean      @default(true) @map("impacta_absenteismo")
  justificada        Boolean      @default(true)
  requerDocumento    Boolean      @default(false) @map("requer_documento")
  ativo              Boolean      @default(true)
  dataCriacao        DateTime     @default(now()) @map("data_criacao")
  ausencias          Ausencia[]
  frequencias        Frequencia[]

  @@map("tipo_ausencia")
}

model Frequencia {
  idFrequencia              Int                         @id @default(autoincrement()) @map("id_frequencia")
  opsId                     String                      @map("ops_id") @db.VarChar(50)
  dataReferencia            DateTime                    @map("data_referencia") @db.Date
  idTipoAusencia            Int?                        @map("id_tipo_ausencia")
  horaEntrada               DateTime?                   @map("hora_entrada") @db.Time(6)
  horaSaida                 DateTime?                   @map("hora_saida") @db.Time(6)
  horasTrabalhadas          Decimal?                    @map("horas_trabalhadas") @db.Decimal(4, 2)
  observacao                String?
  justificativa             String?
  documentoAnexo            String?                     @map("documento_anexo") @db.VarChar(500)
  dataRegistro              DateTime                    @default(now()) @map("data_registro")
  registradoPor             String?                     @map("registrado_por") @db.VarChar(50)
  validado                  Boolean                     @default(false)
  validadoPor               String?                     @map("validado_por") @db.VarChar(50)
  dataValidacao             DateTime?                   @map("data_validacao")
  manual                    Boolean?                    @default(false)
  idSetor                   Int?                        @map("id_setor")
  setor                     Setor?                      @relation(fields: [idSetor], references: [idSetor], onUpdate: NoAction)
  tipoAusencia              TipoAusencia?               @relation(fields: [idTipoAusencia], references: [idTipoAusencia])
  colaborador               Colaborador                 @relation(fields: [opsId], references: [opsId])
  historico                 FrequenciaHistorico[]
  SugestaoMedidaDisciplinar SugestaoMedidaDisciplinar[]

  @@unique([opsId, dataReferencia])
  @@index([opsId])
  @@index([dataReferencia])
  @@index([idTipoAusencia])
  @@index([idSetor])
  @@index([dataReferencia, idSetor])
  @@index([dataReferencia, idTipoAusencia])
  @@map("frequencia")
}

model Ausencia {
  idAusencia          Int            @id @default(autoincrement()) @map("id_ausencia")
  opsId               String         @map("ops_id") @db.VarChar(50)
  idTipoAusencia      Int            @map("id_tipo_ausencia")
  dataInicio          DateTime       @map("data_inicio") @db.Date
  dataFim             DateTime       @map("data_fim") @db.Date
  dataPrevistaRetorno DateTime?      @map("data_prevista_retorno") @db.Date
  diasCorridos        Int?           @map("dias_corridos")
  diasUteis           Int?           @map("dias_uteis")
  motivo              String?
  documentoAnexo      String?        @map("documento_anexo") @db.VarChar(500)
  numeroProtocolo     String?        @map("numero_protocolo") @db.VarChar(100)
  status              StatusAusencia @default(ATIVO)
  dataRegistro        DateTime       @default(now()) @map("data_registro")
  registradoPor       String?        @map("registrado_por") @db.VarChar(50)
  dataAtualizacao     DateTime       @default(now()) @updatedAt @map("data_atualizacao")
  tipoAusencia        TipoAusencia   @relation(fields: [idTipoAusencia], references: [idTipoAusencia])
  colaborador         Colaborador    @relation(fields: [opsId], references: [opsId])

  @@index([opsId])
  @@index([dataInicio, dataFim])
  @@index([status])
  @@index([idTipoAusencia])
  @@index([opsId, status, dataInicio, dataFim])
  @@index([status, dataInicio, dataFim])
  @@map("ausencia")
}

model HistoricoMovimentacao {
  idHistorico      Int         @id @default(autoincrement()) @map("id_historico")
  opsId            String      @map("ops_id") @db.VarChar(50)
  tipoMovimentacao String      @map("tipo_movimentacao") @db.VarChar(50)
  setorAnterior    Int?        @map("setor_anterior")
  cargoAnterior    Int?        @map("cargo_anterior")
  estacaoAnterior  Int?        @map("estacao_anterior")
  turnoAnterior    Int?        @map("turno_anterior")
  liderAnterior    String?     @map("lider_anterior") @db.VarChar(50)
  setorNovo        Int?        @map("setor_novo")
  cargoNovo        Int?        @map("cargo_novo")
  estacaoNova      Int?        @map("estacao_nova")
  turnoNovo        Int?        @map("turno_novo")
  liderNovo        String?     @map("lider_novo") @db.VarChar(50)
  dataEfetivacao   DateTime    @map("data_efetivacao") @db.Date
  motivo           String?
  registradoPor    String?     @map("registrado_por") @db.VarChar(50)
  colaborador      Colaborador @relation("ColaboradorMovimentado", fields: [opsId], references: [opsId])

  @@index([opsId])
  @@index([dataEfetivacao])
  @@map("historico_movimentacao")
}

model User {
  id                                        String                   @id @default(uuid())
  name                                      String
  email                                     String                   @unique
  password                                  String
  role                                      UserRole                 @default(USER)
  avatar                                    String?
  isActive                                  Boolean                  @default(true)
  createdAt                                 DateTime                 @default(now())
  updatedAt                                 DateTime                 @updatedAt
  opsId                                     String?                  @map("ops_id") @db.VarChar(50)
  idEstacao                                 Int?                     @map("id_estacao")
  passwordResetToken                        String?                  @unique @map("password_reset_token")
  passwordResetExpires                      DateTime?                @map("password_reset_expires")
  estacao                                   Estacao?                 @relation(fields: [idEstacao], references: [idEstacao])
  folgasDominicaisCriadas                   FolgaDominical[]
  solicitacoesTreinamentoCriadas            SolicitacaoTreinamento[] @relation("SolicitacaoTreinamentoSolicitante")
  solicitacoesTreinamentoDecididas          SolicitacaoTreinamento[] @relation("SolicitacaoTreinamentoDecisor")
  solicitacoesOperacionaisCriadas           SolicitacaoOperacional[] @relation("SolicitacaoOperacionalSolicitante")
  solicitacoesOperacionaisDecididas         SolicitacaoOperacional[] @relation("SolicitacaoOperacionalDecisor")
  solicitacoesOperacionaisPrimeiraAprovacao SolicitacaoOperacional[] @relation("SolicitacaoOperacionalPrimeiraAprovacao")

  @@index([opsId], map: "idx_users_ops_id")
  @@index([idEstacao], map: "idx_users_id_estacao")
  @@map("users")
}

model Empresa {
  idEmpresa                              Int                      @id @default(autoincrement()) @map("id_empresa")
  razaoSocial                            String                   @map("razao_social") @db.VarChar(200)
  cnpj                                   String?                  @db.VarChar(18)
  ativo                                  Boolean                  @default(true)
  dataCriacao                            DateTime                 @default(now()) @map("data_criacao")
  dataAtualizacao                        DateTime                 @default(now()) @updatedAt @map("data_atualizacao")
  idEstacao                              Int?                     @map("id_estacao")
  estacao                                Estacao?                 @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_empresa_estacao")
  colaboradores                          Colaborador[]
  contratos                              Contrato[]
  desligamentos                          Desligamento[]
  dwReais                                DwReal[]
  solicitacoesOperacionaisInternalizacao SolicitacaoOperacional[]

  @@unique([razaoSocial, idEstacao], map: "uq_empresa_razao_estacao")
  @@unique([cnpj, idEstacao], map: "uq_empresa_cnpj_estacao")
  @@index([idEstacao], map: "idx_empresa_id_estacao")
  @@map("empresa")
}

model Setor {
  idSetor                 Int                      @id @default(autoincrement()) @map("id_setor")
  nomeSetor               String                   @map("nome_setor") @db.VarChar(100)
  descricao               String?
  ativo                   Boolean                  @default(true)
  dataCriacao             DateTime                 @default(now()) @map("data_criacao")
  idEstacao               Int?                     @map("id_estacao")
  estacao                 Estacao?                 @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_setor_estacao")
  colaboradores           Colaborador[]
  frequencias             Frequencia[]
  treinamentos            TreinamentoSetor[]
  solicitacoesTreinamento SolicitacaoTreinamento[]

  @@unique([nomeSetor, idEstacao], map: "uq_setor_nome_estacao")
  @@index([idEstacao], map: "idx_setor_id_estacao")
  @@map("setor")
}

model Cargo {
  idCargo       Int           @id @default(autoincrement()) @map("id_cargo")
  nomeCargo     String        @map("nome_cargo") @db.VarChar(100)
  nivel         String?       @db.VarChar(50)
  descricao     String?
  ativo         Boolean       @default(true)
  dataCriacao   DateTime      @default(now()) @map("data_criacao")
  idEstacao     Int?          @map("id_estacao")
  estacao       Estacao?      @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_cargo_estacao")
  colaboradores Colaborador[]

  @@unique([nomeCargo, idEstacao], map: "uq_cargo_nome_estacao")
  @@index([idEstacao], map: "idx_cargo_id_estacao")
  @@map("cargo")
}

model Estacao {
  idEstacao                       Int                           @id @default(autoincrement()) @map("id_estacao")
  nomeEstacao                     String                        @unique @map("nome_estacao") @db.VarChar(100)
  localizacao                     String?                       @db.VarChar(200)
  capacidade                      Int?
  ativo                           Boolean                       @default(true)
  dataCriacao                     DateTime                      @default(now()) @map("data_criacao")
  idRegional                      Int?                          @map("id_regional")
  sheetsMetaProducaoId            String?                       @map("sheets_meta_producao_id") @db.VarChar(200)
  // Planilha/aba de produção realizada (OnTime) específica da estação — quando
  // nula, cai no padrão global (planilha de Jaboatão + aba PRIMARY/BACKUP).
  sheetsProducaoOnTimeId          String?                       @map("sheets_producao_ontime_id") @db.VarChar(200)
  sheetsProducaoOnTimeAba         String?                       @map("sheets_producao_ontime_aba") @db.VarChar(100)
  sheetsPresencaId                String?                       @map("sheets_presenca_id") @db.VarChar(200)
  // station_id do SPX/Tampermonkey desta estação (liga os envios dos userscripts à estação do COPEOPLE)
  spxStationId                    Int?                          @unique @map("spx_station_id")
  emailRh                         String[]                      @default([]) @map("email_rh")
  seatalkGroupId                  String?                       @map("seatalk_group_id") @db.VarChar(200)
  seatalkGroupIdPacking           String?                       @map("seatalk_group_id_packing") @db.VarChar(200)
  colaboradores                   Colaborador[]
  users                           User[]
  setores                         Setor[]
  cargos                          Cargo[]
  turnos                          Turno[]
  empresas                        Empresa[]
  escalas                         Escala[]
  desligamentos                   Desligamento[]
  dwPlanejados                    DwPlanejado[]
  dwReais                         DwReal[]
  producaoHoraHistoricos          ProducaoHoraHistorico[]
  regional                        Regional?                     @relation(fields: [idRegional], references: [idRegional], onUpdate: NoAction, map: "fk_estacao_regional")
  aprovadoresTreinamento          AprovadorTreinamento[]
  aprovadoresOperacionais         AprovadorOperacional[]
  segundosAprovadoresOperacionais SegundoAprovadorOperacional[]
  esteiras                        MapaEsteira[]
  alocacoesMapaOperacional        MapaAlocacao[]
  timesOperacionais               TimeOperacional[]
  sinergiasInternas               SinergiaInterna[]

  @@index([idRegional], map: "idx_estacao_id_regional")
  @@map("estacao")
}

model Escala {
  idEscala                 Int                          @id @default(autoincrement()) @map("id_escala")
  nomeEscala               String                       @map("nome_escala") @db.VarChar(100)
  tipoEscala               String?                      @map("tipo_escala") @db.VarChar(50)
  diasTrabalhados          Int?                         @map("dias_trabalhados")
  diasFolga                Int?                         @map("dias_folga")
  diasDsr                  Int[]                        @default([]) @map("dias_dsr")
  descricao                String?
  ativo                    Boolean                      @default(true)
  dataCriacao              DateTime                     @default(now()) @map("data_criacao")
  idEstacao                Int?                         @map("id_estacao")
  estacao                  Estacao?                     @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_escala_estacao")
  colaboradores            Colaborador[]
  historicoEscalas         ColaboradorEscalaHistorico[]
  solicitacoesOperacionais SolicitacaoOperacional[]

  @@unique([nomeEscala, idEstacao], map: "uq_escala_nome_estacao")
  @@index([idEstacao], map: "idx_escala_id_estacao")
  @@map("escala")
}

model Turno {
  idTurno                            Int                      @id @default(autoincrement()) @map("id_turno")
  nomeTurno                          String                   @map("nome_turno") @db.VarChar(50)
  horarioInicio                      DateTime                 @map("horario_inicio") @db.Time(6)
  horarioFim                         DateTime                 @map("horario_fim") @db.Time(6)
  ativo                              Boolean                  @default(true)
  isOperacional                      Boolean                  @default(true) @map("is_operacional")
  dataCriacao                        DateTime                 @default(now()) @map("data_criacao")
  idEstacao                          Int?                     @map("id_estacao")
  estacao                            Estacao?                 @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_turno_estacao")
  colaboradores                      Colaborador[]
  dwPlanejados                       DwPlanejado[]
  dwReais                            DwReal[]
  treinamentos                       Treinamento[]
  solicitacoesTreinamento            SolicitacaoTreinamento[]
  solicitacoesOperacionaisTrocaTurno SolicitacaoOperacional[]

  @@unique([nomeTurno, idEstacao], map: "uq_turno_nome_estacao")
  @@index([idEstacao], map: "idx_turno_id_estacao")
  @@map("turno")
}

model Contrato {
  idContrato    Int           @id @default(autoincrement()) @map("id_contrato")
  nomeContrato  String        @map("nome_contrato") @db.VarChar(100)
  idEmpresa     Int?          @map("id_empresa")
  dataInicio    DateTime?     @map("data_inicio") @db.Date
  dataFim       DateTime?     @map("data_fim") @db.Date
  ativo         Boolean       @default(true)
  dataCriacao   DateTime      @default(now()) @map("data_criacao")
  colaboradores Colaborador[]
  empresa       Empresa?      @relation(fields: [idEmpresa], references: [idEmpresa])

  @@map("contrato")
}

model Colaborador {
  opsId                                 String                               @id @map("ops_id") @db.VarChar(50)
  nomeCompleto                          String                               @map("nome_completo") @db.VarChar(200)
  genero                                String?                              @db.VarChar(20)
  matricula                             String                               @unique @db.VarChar(50)
  dataAdmissao                          DateTime                             @map("data_admissao") @db.Date
  dataDesligamento                      DateTime?                            @map("data_desligamento") @db.Date
  motivoDesligamento                    MotivoDesligamento?                  @map("motivo_desligamento")
  tipoDesligamento                      TipoDesligamento?                    @map("tipo_desligamento")
  dataInicioStatus                      DateTime?                            @map("data_inicio_status") @db.Date
  dataFimStatus                         DateTime?                            @map("data_fim_status") @db.Date
  horarioInicioJornada                  DateTime                             @map("horario_inicio_jornada") @db.Time(6)
  primeiroDiaPosDsr                     DateTime?                            @map("primeiro_dia_pos_dsr") @db.Date
  idSetor                               Int?                                 @map("id_setor")
  idCargo                               Int?                                 @map("id_cargo")
  idLider                               String?                              @map("id_lider") @db.VarChar(50)
  idEstacao                             Int?                                 @map("id_estacao")
  idEmpresa                             Int?                                 @map("id_empresa")
  idContrato                            Int?                                 @map("id_contrato")
  idEscala                              Int?                                 @map("id_escala")
  idTurno                               Int?                                 @map("id_turno")
  status                                StatusColaborador                    @default(ATIVO)
  dataCriacao                           DateTime                             @default(now()) @map("data_criacao")
  dataAtualizacao                       DateTime                             @default(now()) @updatedAt @map("data_atualizacao")
  cpf                                   String?                              @unique @db.VarChar(14)
  dataNascimento                        DateTime?                            @map("data_nascimento")
  email                                 String?                              @unique @db.VarChar(200)
  telefone                              String?                              @db.VarChar(20)
  contatoEmergenciaNome                 String?                              @map("contato_emergencia_nome") @db.VarChar(200)
  contatoEmergenciaTelefone             String?                              @map("contato_emergencia_telefone") @db.VarChar(20)
  cipa                                  Boolean                              @default(false)
  gestante                              Boolean                              @default(false)
  tipoDeslocamento                      TipoDeslocamento?                    @map("tipo_deslocamento")
  acidentes                             AcidenteTrabalho[]
  atestadosMedicos                      AtestadoMedico[]
  ausencias                             Ausencia[]
  cargo                                 Cargo?                               @relation(fields: [idCargo], references: [idCargo])
  contrato                              Contrato?                            @relation(fields: [idContrato], references: [idContrato])
  empresa                               Empresa?                             @relation(fields: [idEmpresa], references: [idEmpresa])
  escala                                Escala?                              @relation(fields: [idEscala], references: [idEscala])
  estacao                               Estacao?                             @relation(fields: [idEstacao], references: [idEstacao])
  lider                                 Colaborador?                         @relation("LiderSubordinado", fields: [idLider], references: [opsId])
  subordinados                          Colaborador[]                        @relation("LiderSubordinado")
  setor                                 Setor?                               @relation(fields: [idSetor], references: [idSetor])
  turno                                 Turno?                               @relation(fields: [idTurno], references: [idTurno])
  desligamentos                         Desligamento[]
  frequencias                           Frequencia[]
  historicoMovimentacao                 HistoricoMovimentacao[]              @relation("ColaboradorMovimentado")
  medidasDisciplinares                  MedidaDisciplinar[]
  treinamentosLiderados                 Treinamento[]                        @relation("TreinamentoLider")
  treinamentosParticipou                TreinamentoParticipante[]
  folgasDominicais                      FolgaDominical[]
  sugestoesMedidaDisciplinar            SugestaoMedidaDisciplinar[]
  solicitacoesTreinamentoParticipou     SolicitacaoTreinamentoParticipante[]
  solicitacoesOperacionais              SolicitacaoOperacional[]             @relation("SolicitacaoOperacionalColaborador1")
  solicitacoesOperacionaisPar           SolicitacaoOperacional[]             @relation("SolicitacaoOperacionalColaborador2")
  solicitacoesOperacionaisComoNovoLider SolicitacaoOperacional[]             @relation("SolicitacaoOperacionalNovoLider")
  alocacoesMapaOperacional              MapaAlocacao[]
  timeIntegrantes                       TimeIntegrante[]
  sinergiasInternas                     SinergiaInterna[]

  @@index([matricula])
  @@index([status])
  @@index([idSetor])
  @@index([idLider])
  @@index([dataAdmissao])
  @@index([idEstacao])
  @@index([idTurno])
  @@index([idEmpresa])
  @@index([dataFimStatus])
  @@index([idEstacao, status])
  @@index([idEstacao, idTurno, status])
  @@map("colaborador")
}

model AtestadoMedico {
  idAtestado      Int            @id @default(autoincrement()) @map("id_atestado")
  opsId           String         @map("ops_id") @db.VarChar(50)
  dataInicio      DateTime       @map("data_inicio") @db.Date
  dataFim         DateTime       @map("data_fim") @db.Date
  diasAfastamento Int            @map("dias_afastamento")
  cid             String?        @db.VarChar(10)
  observacao      String?
  documentoAnexo  String?        @map("documento_anexo") @db.VarChar(500)
  status          StatusAtestado @default(ATIVO)
  dataRegistro    DateTime       @default(now()) @map("data_registro")
  registradoPor   String?        @map("registrado_por") @db.VarChar(50)
  colaborador     Colaborador    @relation(fields: [opsId], references: [opsId])

  @@index([opsId])
  @@index([dataInicio, dataFim])
  @@index([status])
  @@index([opsId, status])
  @@map("atestado_medico")
}

model MedidaDisciplinar {
  idMedida Int @id @default(autoincrement()) @map("id_medida")

  opsId       String      @map("ops_id")
  colaborador Colaborador @relation(fields: [opsId], references: [opsId])

  nivelViolacao NivelViolacao @map("nivel_violacao")

  violacao String @db.VarChar(200)

  tipoMedida TipoMedidaDisciplinar @map("tipo_medida")

  diasSuspensao Int? @map("dias_suspensao")

  motivo String

  dataOcorrencia DateTime @map("data_ocorrencia")

  dataAplicacao DateTime @map("data_aplicacao")

  status StatusMedidaDisciplinar @default(PENDENTE_ASSINATURA)

  origem String? @db.VarChar(50)

  ataGeradaUrl String? @map("ata_gerada_url")

  documentoAssinadoUrl String? @map("documento_assinado_url")

  registradoPor String? @map("registrado_por")

  dataAssinatura DateTime? @map("data_assinatura")

  dataRegistro DateTime @default(now()) @map("data_registro")

  dataCriacao DateTime @default(now()) @map("data_criacao")

  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  idMatriz Int? @map("id_matriz")

  matriz MatrizMedidaDisciplinar? @relation(fields: [idMatriz], references: [idMatriz])

  @@index([opsId])
  @@index([dataAplicacao])
  @@index([status])
  @@index([origem])
  @@map("medida_disciplinar")
}

model MatrizMedidaDisciplinar {
  idMatriz Int @id @default(autoincrement()) @map("id_matriz")

  nivelViolacao NivelViolacao @map("nivel_violacao")

  violacao String @db.VarChar(200)

  frequencia FrequenciaViolacao

  consequencia TipoMedidaDisciplinar

  diasSuspensao Int? @map("dias_suspensao")

  createdAt DateTime @default(now()) @map("created_at")

  medidas MedidaDisciplinar[]

  @@unique([nivelViolacao, violacao, frequencia])
  @@index([violacao])
  @@map("matriz_medida_disciplinar")
}

model SugestaoMedidaDisciplinar {
  idSugestao Int @id @default(autoincrement()) @map("id_sugestao")

  opsId String @map("ops_id")

  idFrequencia Int? @map("id_frequencia")

  frequencia Frequencia? @relation(fields: [idFrequencia], references: [idFrequencia])

  colaborador Colaborador @relation(fields: [opsId], references: [opsId])

  dataReferencia DateTime @map("data_referencia") @db.Date

  violacao String @db.VarChar(200)

  consequencia TipoMedidaDisciplinar

  diasSuspensao Int? @map("dias_suspensao")

  // Número de dias consecutivos que originaram esta sugestão (1 = falta isolada)
  diasConsecutivos Int @default(1) @map("dias_consecutivos")

  status StatusSugestao @default(PENDENTE)

  aprovadoPor    String? @map("aprovado_por")
  motivoRejeicao String? @map("motivo_rejeicao")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([opsId])
  @@index([dataReferencia])
  @@index([status])
  @@map("sugestao_medida_disciplinar")
}

model AcidenteTrabalho {
  idAcidente           Int                 @id @default(autoincrement())
  opsIdColaborador     String
