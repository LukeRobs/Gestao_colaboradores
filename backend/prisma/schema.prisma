// Trilha de auditoria das mudanças de status do colaborador (quem, de qual para qual,
// quando e por qual fluxo). Sem FK de propósito: o histórico precisa sobreviver a
// exclusões/renomeações; o script de troca de OPS ID atualiza esta tabela explicitamente.
model ColaboradorStatusAuditoria {
  id             Int      @id @default(autoincrement())
  opsId          String   @map("ops_id") @db.VarChar(50)
  statusAnterior String?  @map("status_anterior") @db.VarChar(20)
  statusNovo     String   @map("status_novo") @db.VarChar(20)
  alteradoPor    String?  @map("alterado_por") @db.VarChar(50)
  origem         String   @db.VarChar(60)
  detalhe        String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamp(6)

  @@index([opsId, criadoEm], map: "idx_colab_status_aud_ops")
  @@index([criadoEm], map: "idx_colab_status_aud_data")
  @@map("colaborador_status_auditoria")
}

// =====================================================
// SINERGIA INTERNA (Label) — movimentação temporária de colaboradores
// entre áreas da operação, confirmada fisicamente por QR Code.
// NÃO tem relação com a Sinergia de Solicitação Operacional (ponto S1) e
// não altera presença nem o setor base do colaborador.
// Campos de usuário são texto (id de users) com FK criada na migration SQL;
// os nomes são resolvidos na aplicação.
// =====================================================

enum SinergiaInternaStatus {
  SOLICITADA
  EM_DESLOCAMENTO
  SINERGIA_ATIVA
  AGUARDANDO_RETORNO
  FINALIZADA
  CANCELADA
  EXPIRADA
}

model MapaArea {
  idArea   Int     @id @default(autoincrement()) @map("id_area")
  codigo   String  @unique(map: "uq_mapa_area_codigo") @db.VarChar(30)
  nome     String  @db.VarChar(60)
  contexto String  @db.VarChar(20) // ESTEIRA | RECEBIMENTO | EXPEDICAO (mesmas regras de elegibilidade da Label)
  ordem    Int     @default(0)
  ativo    Boolean @default(true)

  origens  SinergiaInterna[] @relation("SinergiaAreaOrigem")
  destinos SinergiaInterna[] @relation("SinergiaAreaDestino")

  @@map("mapa_area")
}

// Solicitação em grupo: um QR de ida e um de retorno para todos os colaboradores do lote.
model SinergiaInternaLote {
  idLote           Int      @id @default(autoincrement()) @map("id_lote")
  idEstacao        Int      @map("id_estacao")
  solicitadoPor    String   @map("solicitado_por")
  qrToken          String   @unique(map: "uq_sinergia_interna_lote_qr_token") @map("qr_token") @db.VarChar(40)
  qrRetornoToken   String   @unique(map: "uq_sinergia_interna_lote_qr_retorno_token") @map("qr_retorno_token") @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at")

  sinergias SinergiaInterna[]

  @@map("sinergia_interna_lote")
}

model SinergiaInterna {
  idSinergia Int    @id @default(autoincrement()) @map("id_sinergia")
  idEstacao  Int    @map("id_estacao")
  opsId      String @map("ops_id") @db.VarChar(50)

  // Preenchido quando criada junto com outras (2 ou mais); null = solicitação unitária.
  idLote Int? @map("id_lote")

  idAreaOrigem  Int @map("id_area_origem")
  idAreaDestino Int @map("id_area_destino")

  solicitadoPor        String  @map("solicitado_por")
  enviadoPor           String? @map("enviado_por")
  recebidoPor          String? @map("recebido_por")
  finalizadoPor        String? @map("finalizado_por")
  retornoConfirmadoPor String? @map("retorno_confirmado_por")
  canceladoPor         String? @map("cancelado_por")
  prorrogadoPor        String? @map("prorrogado_por")

  motivo            String  @db.VarChar(40)
  motivoComplemento String? @map("motivo_complemento") @db.VarChar(300)

  // Onde a pessoa vai trabalhar no destino (função na esteira, Conferente/Push, Received/Pull/FIFO...).
  // Nulo no Full D+1 (pool, sem função) e em sinergias anteriores a este campo.
  funcaoDestino String? @map("funcao_destino") @db.VarChar(30)

  turno          String   @db.VarChar(10)
  diaOperacional DateTime @map("dia_operacional") @db.Date

  dataSolicitacao DateTime  @default(now()) @map("data_solicitacao")
  dataEnvio       DateTime? @map("data_envio")
  dataChegada     DateTime? @map("data_chegada")
  dataFimDestino  DateTime? @map("data_fim_destino") // líder do destino encerrou (aguardando retorno)
  dataFinalizacao DateTime? @map("data_finalizacao") // retorno físico confirmado

  inicioPrevisto DateTime @map("inicio_previsto")
  fimPrevisto    DateTime @map("fim_previsto")

  status SinergiaInternaStatus @default(SOLICITADA)

  qrToken          String?   @unique(map: "uq_sinergia_interna_qr_token") @map("qr_token") @db.VarChar(40)
  qrGeradoEm       DateTime? @map("qr_gerado_em")
  qrUsadoEm        DateTime? @map("qr_usado_em")
  qrRetornoToken   String?   @unique(map: "uq_sinergia_interna_qr_retorno_token") @map("qr_retorno_token") @db.VarChar(40)
  qrRetornoGeradoEm DateTime? @map("qr_retorno_gerado_em")
  qrRetornoUsadoEm DateTime? @map("qr_retorno_usado_em")

  prorrogacoes      Int       @default(0)
  prorrogadoEm      DateTime? @map("prorrogado_em")
  motivoProrrogacao String?   @map("motivo_prorrogacao") @db.VarChar(300)

  canceladoEm        DateTime? @map("cancelado_em")
  motivoCancelamento String?   @map("motivo_cancelamento") @db.VarChar(300)

  // Exceção auditada: retorno confirmado sem QR (etiqueta perdida/danificada)
  retornoManual              Boolean @default(false) @map("retorno_manual")
  retornoManualJustificativa String? @map("retorno_manual_justificativa") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lote        SinergiaInternaLote?    @relation(fields: [idLote], references: [idLote], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_lote")
  estacao     Estacao                 @relation(fields: [idEstacao], references: [idEstacao], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_estacao")
  colaborador Colaborador             @relation(fields: [opsId], references: [opsId], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_colaborador")
  areaOrigem  MapaArea                @relation("SinergiaAreaOrigem", fields: [idAreaOrigem], references: [idArea], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_area_origem")
  areaDestino MapaArea                @relation("SinergiaAreaDestino", fields: [idAreaDestino], references: [idArea], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_area_destino")
  eventos     SinergiaInternaEvento[]

  @@index([idEstacao, status], map: "idx_sinergia_interna_estacao_status")
  @@index([opsId, status], map: "idx_sinergia_interna_ops_status")
  @@index([idEstacao, diaOperacional], map: "idx_sinergia_interna_dia")
  @@index([idAreaOrigem, status], map: "idx_sinergia_interna_origem_status")
  @@index([idAreaDestino, status], map: "idx_sinergia_interna_destino_status")
  @@index([idLote], map: "idx_sinergia_interna_lote")
  @@map("sinergia_interna")
}

model SinergiaInternaEvento {
  idEvento       Int                    @id @default(autoincrement()) @map("id_evento")
  idSinergia     Int                    @map("id_sinergia")
  acao           String                 @db.VarChar(40)
  statusAnterior SinergiaInternaStatus? @map("status_anterior")
  statusNovo     SinergiaInternaStatus? @map("status_novo")
  userId         String?                @map("user_id")
  userNome       String?                @map("user_nome")
  ip             String?                @db.VarChar(64)
  dispositivo    String?                @db.VarChar(255)
  detalhe        Json?
  criadoEm       DateTime               @default(now()) @map("criado_em")

  sinergia SinergiaInterna @relation(fields: [idSinergia], references: [idSinergia], onDelete: NoAction, onUpdate: NoAction, map: "fk_sinergia_interna_evento_sinergia")

  @@index([idSinergia, criadoEm], map: "idx_sinergia_interna_evento_sinergia")
  @@map("sinergia_interna_evento")
}

// Avisos da Label (estilo Waze): ocorrência sinalizada num braço, função ou doca. Expira sozinha.
model MapaAviso {
  idAviso    String   @id @default(uuid()) @map("id_aviso")
  idEstacao  Int      @map("id_estacao")
  alvoTipo   String   @map("alvo_tipo") @db.VarChar(10) // BRACO | FUNCAO | DOCA
  idEsteira  Int?     @map("id_esteira")
  braco      Int?
  lado       String?  @db.VarChar(1)
  labor      String?  @db.VarChar(30)
  numeroDoca Int?     @map("numero_doca")
  motivo     String   @db.VarChar(20)
  severidade String   @default("ATENCAO") @db.VarChar(10) // ATENCAO | CRITICO
  texto      String?  @db.VarChar(200)
  opsId      String?  @map("ops_id") @db.VarChar(50)
  nomePessoa String?  @map("nome_pessoa")

  criadoPorId      String?   @map("criado_por_id")
  criadoPorNome    String?   @map("criado_por_nome")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  expiraEm         DateTime  @map("expira_em")
  encerradoEm      DateTime? @map("encerrado_em")
  encerradoPorId   String?   @map("encerrado_por_id")
  encerradoPorNome String?   @map("encerrado_por_nome")

  @@index([idEstacao, encerradoEm, expiraEm], map: "idx_mapa_aviso_ativos")
  @@index([idEstacao, alvoTipo, idEsteira, numeroDoca], map: "idx_mapa_aviso_alvo")
  @@map("mapa_aviso")
}
