  turno      Turno     @relation(fields: [idTurno], references: [idTurno], onDelete: NoAction, onUpdate: NoAction, map: "fk_dw_planejado_turno")
  estacao    Estacao?  @relation(fields: [idEstacao], references: [idEstacao], onDelete: NoAction, onUpdate: NoAction, map: "fk_dw_planejado_estacao")

  @@unique([data, idTurno, idEstacao], map: "uq_dw_planejado")
  @@index([idEstacao], map: "idx_dw_planejado_id_estacao")
