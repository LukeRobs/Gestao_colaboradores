model DwReal {
  id         Int       @id @default(autoincrement())
  data       DateTime  @map("data") @db.Date
  idTurno    Int       @map("id_turno")
  idEmpresa  Int       @map("id_empresa")
  idEstacao  Int?      @map("id_estacao")
  quantidade Int
  observacao String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  empresa    Empresa   @relation(fields: [idEmpresa], references: [idEmpresa], onDelete: NoAction, onUpdate: NoAction, map: "fk_dw_real_empresa")
  turno      Turno     @relation(fields: [idTurno], references: [idTurno], onDelete: NoAction, onUpdate: NoAction, map: "fk_dw_real_turno")
