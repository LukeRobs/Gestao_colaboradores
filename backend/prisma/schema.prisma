// =====================================================
// MAPA OPERACIONAL (esteiras, braços, alocação de mão de obra)
// Prefixo "Mapa" nos models porque já existe, sem relação alguma
// com este módulo, uma tabela `esteira`/`esteira_capacidade_hora`
// legada no banco (schema drift — nenhum código no repo referencia
// mais essas tabelas, mas os nomes ficaram ocupados).
// =====================================================

enum MapaEsteiraFormato {
  LINHA
  U
}

model MapaEsteira {
  idEsteira Int                @id @default(autoincrement()) @map("id_esteira")
  idEstacao Int                @map("id_estacao")
  nome      String             @db.VarChar(100)
  formato   MapaEsteiraFormato
  temLadoA  Boolean            @default(true) @map("tem_lado_a")
  temLadoB  Boolean            @default(true) @map("tem_lado_b")
  qtdBracos Int                @map("qtd_bracos")
  ordem     Int                @default(0)
  ativo     Boolean            @default(true)

  estacao       Estacao                   @relation(fields: [idEstacao], references: [idEstacao], onDelete: NoAction, onUpdate: NoAction, map: "fk_mapa_esteira_estacao")
  bracos        MapaEsteiraBraco[]
  alocacoes     MapaAlocacao[]
  producaoHoras MapaEsteiraProducaoHora[]

  @@unique([idEstacao, nome], map: "uq_mapa_esteira_estacao_nome")
  @@map("mapa_esteira")
}

model MapaEsteiraBraco {
  idEsteiraBraco Int      @id @default(autoincrement()) @map("id_esteira_braco")
  idEsteira      Int      @map("id_esteira")
  numero         Int
  lado           String   @db.VarChar(1)
  habilitado     Boolean  @default(true)
  fanouts        String[] @default([])
  observacoes    String?

  esteira MapaEsteira @relation(fields: [idEsteira], references: [idEsteira], onDelete: Cascade, onUpdate: NoAction, map: "fk_mapa_esteira_braco_esteira")

  @@unique([idEsteira, numero, lado], map: "uq_mapa_esteira_braco")
  @@map("mapa_esteira_braco")
}

enum MapaAlocacaoLabor {
  PACKING
  INDUCAO
  PESCA
  GOL
  APOIO
  ENDERECAMENTO
  ABASTECEDOR
  MONTAGEM_SCUTTLE
  VOLANTE
  LOG_II
  DOCK_RECEIVED
  DOCK_PULL
  DOCK_PUSH
  DOCK_CONFERENTE
  DOCK_FIFO
  DOCK_LOG_II
  DOCK_VOLANTE
  FULL_D1
}

enum MapaAlocacaoOrigem {
  MANUAL
  AUTO
}

enum MapaDocaOperacao {
  INBOUND
  OUTBOUND
}

model MapaAlocacao {
  idAlocacao String             @id @default(uuid()) @map("id_alocacao")
  idEstacao  Int                @map("id_estacao")
  labor      MapaAlocacaoLabor
  origem     MapaAlocacaoOrigem @default(MANUAL)

  idEsteira Int?    @map("id_esteira")
  braco     Int?
  lado      String? @db.VarChar(1)

  numeroDoca   Int?              @map("numero_doca")
  operacaoDoca MapaDocaOperacao? @map("operacao_doca")
  idTime       Int?              @map("id_time")

  opsId    String? @map("ops_id") @db.VarChar(50)
  diarista Boolean @default(false)

  // Quem fez a alocação/movimentação manual (users.id). Nulo nas automáticas e nas anteriores a este campo.
  idUsuario String? @map("id_usuario")

  inicio DateTime  @default(now())
  fim    DateTime?

  produtividadeInicio  Decimal? @map("produtividade_inicio") @db.Decimal(10, 2)
  produtividadeFim     Decimal? @map("produtividade_fim") @db.Decimal(10, 2)
  produtividadePeriodo Decimal? @map("produtividade_periodo") @db.Decimal(10, 2)

  estacao     Estacao          @relation(fields: [idEstacao], references: [idEstacao], onDelete: NoAction, onUpdate: NoAction, map: "fk_mapa_alocacao_estacao")
  esteira     MapaEsteira?     @relation(fields: [idEsteira], references: [idEsteira], onDelete: NoAction, onUpdate: NoAction, map: "fk_mapa_alocacao_esteira")
  colaborador Colaborador?     @relation(fields: [opsId], references: [opsId], onDelete: NoAction, onUpdate: NoAction, map: "fk_mapa_alocacao_colaborador")
  time        TimeOperacional? @relation(fields: [idTime], references: [idTime], onDelete: NoAction, onUpdate: NoAction, map: "fk_mapa_alocacao_time")

  @@index([idEstacao, fim], map: "idx_mapa_alocacao_estacao_fim")
  @@index([opsId, fim], map: "idx_mapa_alocacao_ops_id_fim")
  @@index([idEsteira, braco, lado, fim], map: "idx_mapa_alocacao_esteira_braco_lado_fim")
  @@index([numeroDoca, fim], map: "idx_mapa_alocacao_numero_doca_fim")
  @@map("mapa_alocacao")
}

// Fanouts por posição do Setup D+1 (pool sem braços): posições numeradas, só lado A.
// Os fanouts das esteiras ficam em mapa_esteira_braco.fanouts.
model MapaSetupFanout {
  idSetupFanout Int      @id @default(autoincrement()) @map("id_setup_fanout")
  idEstacao     Int      @map("id_estacao")
  posicao       Int
  fanouts       String[] @default([])
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([idEstacao, posicao], map: "uq_mapa_setup_fanout_posicao")
  @@map("mapa_setup_fanout")
}

// Trilha de quem mudou os fanouts de cada posição (edição, balanceamento entre braços, carga inicial).
model MapaFanoutHistorico {
  idHistorico Int      @id @default(autoincrement()) @map("id_historico")
  idEstacao   Int      @map("id_estacao")
  escopo      String   @db.VarChar(12) // ESTEIRA | SETUP_D1
  idEsteira   Int?     @map("id_esteira")
  braco       Int
  lado        String   @db.VarChar(1)
  acao        String   @db.VarChar(20) // EDICAO | MOVER_SAIDA | MOVER_ENTRADA | CARGA_INICIAL
  antes       String[] @default([])
  depois      String[] @default([])
  usuarioId   String?  @map("usuario_id")
  usuarioNome String?  @map("usuario_nome")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([idEstacao, criadoEm], map: "idx_mapa_fanout_hist_data")
  @@index([escopo, idEsteira, braco, lado], map: "idx_mapa_fanout_hist_posicao")
  @@map("mapa_fanout_historico")
}

model MapaEsteiraProducaoHora {
  id             Int      @id @default(autoincrement())
  idEsteira      Int      @map("id_esteira")
  dataReferencia DateTime @map("data_referencia") @db.Date
  turno          String   @db.VarChar(10)
  hora           Int

  bracosOcupados         Int @default(0) @map("bracos_ocupados")
  bracosLivres           Int @default(0) @map("bracos_livres")
  operadoresAutoAlocados Int @default(0) @map("operadores_auto_alocados")
  producaoTotal          Int @default(0) @map("producao_total")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  esteira MapaEsteira @relation(fields: [idEsteira], references: [idEsteira], onDelete: Cascade, onUpdate: NoAction, map: "fk_mapa_esteira_producao_hora_esteira")

  @@unique([idEsteira, dataReferencia, hora], map: "uq_mapa_esteira_producao_hora")
  @@map("mapa_esteira_producao_hora")
}

// Produção do turno por esteira, calculada a partir do "Total Throughput"
// por workstation (aba "Productivity Workstation" — contador por estação
// física, não por operador). throughputBase é o valor lido no primeiro
// sync dentro do turno; throughputAtual é atualizado a cada tick. A
// produção do turno = soma de (throughputAtual - throughputBase) de todos
// os códigos da esteira. Como é por CÓDIGO (não por pessoa), não importa
// quem entra ou sai da estação no meio do turno — o contador é da estação.
model MapaWorkstationProducaoTurno {
  id              Int      @id @default(autoincrement())
  codigoEstacao   String   @map("codigo_estacao") @db.VarChar(50)
  dataOperacional DateTime @map("data_operacional") @db.Date
  turno           String   @db.VarChar(10)
  throughputBase  Int      @default(0) @map("throughput_base")
  throughputAtual Int      @default(0) @map("throughput_atual")

  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@unique([codigoEstacao, dataOperacional, turno], map: "uq_mapa_ws_producao_turno")
  @@map("mapa_workstation_producao_turno")
}

// =====================================================
// GESTÃO DE DOCAS (Fase 2 do Mapa Operacional)
// Doca é um recurso físico único — a ocupação ativa em MapaAlocacao
// (numeroDoca + fim: null) decide a operação corrente, nunca uma
// propriedade fixa da doca. Times são cadastros reutilizáveis; a
// composição (TimeIntegrante) é dinâmica e não gera uma linha de
// alocação por integrante — uma alocação de doca aponta pro time
// inteiro via idTime.
// =====================================================

enum TimeOperacaoTipo {
  OPERACIONAL
  FIFO
}

enum TimeFuncao {
  RECEIVED
  PULL
  CONFERENTE
  PUSH
  LOG_II
  VOLANTE
}

model TimeOperacional {
  idTime    Int              @id @default(autoincrement()) @map("id_time")
  idEstacao Int              @map("id_estacao")
  nome      String           @db.VarChar(100)
  operacao  MapaDocaOperacao
  tipo      TimeOperacaoTipo @default(OPERACIONAL)
  turno     String           @db.VarChar(10)
  ativo     Boolean          @default(true)
  criadoEm  DateTime         @default(now()) @map("criado_em")

  estacao     Estacao          @relation(fields: [idEstacao], references: [idEstacao], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_operacional_estacao")
  integrantes TimeIntegrante[]
  alocacoes   MapaAlocacao[]

  @@unique([idEstacao, nome], map: "uq_time_operacional_estacao_nome")
  @@map("time_operacional")
}

model TimeIntegrante {
  idTimeIntegrante Int         @id @default(autoincrement()) @map("id_time_integrante")
  idTime           Int         @map("id_time")
  opsId            String      @map("ops_id") @db.VarChar(50)
  funcao           TimeFuncao?
  adicionadoEm     DateTime    @default(now()) @map("adicionado_em")

  time        TimeOperacional @relation(fields: [idTime], references: [idTime], onDelete: Cascade, onUpdate: NoAction, map: "fk_time_integrante_time")
  colaborador Colaborador     @relation(fields: [opsId], references: [opsId], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_integrante_colaborador")

  @@unique([idTime, opsId], map: "uq_time_integrante")
  @@map("time_integrante")
}

// Pré-alocação da Label (esteira sem braço e FULL D+1) de um turno futuro; um job converte em MapaAlocacao no início do turno.
model MapaAlocacaoAgendada {
  idAgendada     String    @id @default(uuid()) @map("id_agendada")
  idEstacao      Int       @map("id_estacao")
  idEsteira      Int?      @map("id_esteira") // null = FULL D+1
  labor          String    @db.VarChar(30)
  opsId          String?   @map("ops_id") @db.VarChar(50)
  diarista       Boolean   @default(false)
  diaOperacional DateTime  @map("dia_operacional") @db.Date
  turno          String    @db.VarChar(2)
  status         String    @default("PENDENTE") @db.VarChar(12) // PENDENTE | ATIVADA | FALHOU
  motivoFalha    String?   @map("motivo_falha")
  idUsuario      String?   @map("id_usuario")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  ativadoEm      DateTime? @map("ativado_em")

  @@index([idEstacao, diaOperacional, turno, status], map: "idx_mapa_alocacao_agendada_turno")
  @@map("mapa_alocacao_agendada")
}

// TOs de transbordo (cd_flag) enviadas pelo Tampermonkey, por estação.
model SpxTransbordoCd {
  id                  Int       @id @default(autoincrement())
