// =====================================================
// SOLICITAÇÕES OPERACIONAIS
// (Folga, Banco de Horas, Sinergia, Troca de DSR)
// =====================================================

model AprovadorOperacional {
  idAprovador     Int      @id @default(autoincrement()) @map("id_aprovador")
  nome            String   @db.VarChar(150)
  email           String   @unique @db.VarChar(200)
  ativo           Boolean  @default(true)
  // null = aprovador válido em todas as estações (somente Admin pode definir)
  idEstacao       Int?     @map("id_estacao")
  dataCriacao     DateTime @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime @default(now()) @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  estacao Estacao? @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_aprovador_operacional_estacao")

  @@index([ativo], map: "idx_aprovador_operacional_ativo")
  @@index([idEstacao], map: "idx_aprovador_operacional_estacao")
  @@map("aprovador_operacional")
}

// Segunda etapa de aprovação: RH confirma Troca de Escala e Troca de DSR;
// Coordenador confirma Folga, Banco de Horas, Hora Extra, Troca de Gestão
// e Desligamento. Sinergia não tem segunda etapa. E-mail cadastrado
// manualmente (não é derivado do cargo do colaborador).
model SegundoAprovadorOperacional {
  idAprovador     Int                  @id @default(autoincrement()) @map("id_aprovador")
  tipo            TipoSegundoAprovador
  nome            String               @db.VarChar(150)
  email           String               @db.VarChar(200)
  ativo           Boolean              @default(true)
  // null = aprovador válido em todas as estações (somente Admin pode definir)
  idEstacao       Int?                 @map("id_estacao")
  dataCriacao     DateTime             @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime             @default(now()) @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  estacao Estacao? @relation(fields: [idEstacao], references: [idEstacao], onUpdate: NoAction, map: "fk_segundo_aprovador_operacional_estacao")

  @@index([ativo], map: "idx_segundo_aprovador_operacional_ativo")
  @@index([idEstacao], map: "idx_segundo_aprovador_operacional_estacao")
  @@index([tipo], map: "idx_segundo_aprovador_operacional_tipo")
  @@map("segundo_aprovador_operacional")
}

model SolicitacaoOperacional {
  idSolicitacao Int                           @id @default(autoincrement()) @map("id_solicitacao")
  tipo          TipoSolicitacaoOperacional
  status        StatusSolicitacaoOperacional  @default(PENDENTE)

  // Colaborador principal (todos os tipos). Para TROCA_DSR = colaborador 1.
  opsId String   @map("ops_id") @db.VarChar(50)
  // Data de referência: folga / BH / sinergia, ou nova data de DSR do colaborador 1
  data  DateTime @db.Date
  motivo String  @db.VarChar(500)

  // Banco de Horas
  bhDiaCompleto     Boolean? @map("bh_dia_completo")
  bhQuantidadeHoras Decimal? @map("bh_quantidade_horas") @db.Decimal(4, 2)
  bhHoraEntrada     String?  @map("bh_hora_entrada") @db.VarChar(10)

  // Sinergia
  sinergiaDestino DestinoSinergia? @map("sinergia_destino")

  // Troca de DSR — colaborador 2 e as 4 datas envolvidas na inversão
  opsId2        String?   @map("ops_id_2") @db.VarChar(50)
  dsrDataAtual1 DateTime? @map("dsr_data_atual_1") @db.Date
  dsrDataNova1  DateTime? @map("dsr_data_nova_1") @db.Date
  dsrDataAtual2 DateTime? @map("dsr_data_atual_2") @db.Date
  dsrDataNova2  DateTime? @map("dsr_data_nova_2") @db.Date

  // Hora Extra em dia de DSR
  heHoraEntrada String? @map("he_hora_entrada") @db.VarChar(10)
  heHoraSaida   String? @map("he_hora_saida") @db.VarChar(10)

  // Troca de Gestão (Liderança)
  novoLiderOpsId String? @map("novo_lider_ops_id") @db.VarChar(50)

  // Troca de Escala
  novaIdEscala Int? @map("nova_id_escala")

  // Desligamento
  dataDesligamentoSolicitada   DateTime?            @map("data_desligamento_solicitada") @db.Date
  motivoDesligamentoSolicitado MotivoDesligamento?  @map("motivo_desligamento_solicitado")
  tipoDesligamentoSolicitado   TipoDesligamento?    @map("tipo_desligamento_solicitado")

  // Troca de Turno
  novoIdTurno Int? @map("novo_id_turno")

  // Férias
  feriasDataInicio DateTime? @map("ferias_data_inicio") @db.Date
  feriasDataFim    DateTime? @map("ferias_data_fim") @db.Date

  // Afastamento
  afastamentoDataInicio DateTime? @map("afastamento_data_inicio") @db.Date
  afastamentoDataFim    DateTime? @map("afastamento_data_fim") @db.Date

  // Internalização — colaborador terceirizado (BPO) passa a ser SPX:
  // muda de empresa e de matrícula. internalizacaoForcada = true quando o
  // colaborador não atendia aos critérios de elegibilidade no momento da
  // solicitação e o solicitante confirmou explicitamente mesmo assim.
  internalizacaoNovaIdEmpresa Int?     @map("internalizacao_nova_id_empresa")
  internalizacaoNovaMatricula String?  @map("internalizacao_nova_matricula") @db.VarChar(50)
  internalizacaoForcada       Boolean  @default(false) @map("internalizacao_forcada")

  solicitanteUserId String    @map("solicitante_user_id")
  decididoPorUserId String?   @map("decidido_por_user_id")
  decididoEm        DateTime? @map("decidido_em") @db.Timestamp(6)
  motivoReprovacao  String?   @map("motivo_reprovacao") @db.VarChar(500)

  // Primeira etapa de aprovação (aprovador padrão da estação). Para os
  // tipos que exigem segunda etapa (RH ou Coordenador), a solicitação
  // fica em AGUARDANDO_SEGUNDA_APROVACAO entre a primeira e a segunda —
  // decididoPor/decididoEm só são preenchidos na decisão final.
  primeiraAprovacaoPorUserId String?   @map("primeira_aprovacao_por_user_id")
  primeiraAprovacaoEm        DateTime? @map("primeira_aprovacao_em") @db.Timestamp(6)

  dataCriacao     DateTime @default(now()) @map("data_criacao") @db.Timestamp(6)
  dataAtualizacao DateTime @default(now()) @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  colaborador       Colaborador                       @relation("SolicitacaoOperacionalColaborador1", fields: [opsId], references: [opsId], map: "fk_solop_colaborador1")
  colaborador2      Colaborador?                      @relation("SolicitacaoOperacionalColaborador2", fields: [opsId2], references: [opsId], map: "fk_solop_colaborador2")
  novoLider         Colaborador?                      @relation("SolicitacaoOperacionalNovoLider", fields: [novoLiderOpsId], references: [opsId], map: "fk_solop_novo_lider")
  novaEscala        Escala?                           @relation(fields: [novaIdEscala], references: [idEscala], onUpdate: NoAction, map: "fk_solop_nova_escala")
  novoTurno         Turno?                            @relation(fields: [novoIdTurno], references: [idTurno], onUpdate: NoAction, map: "fk_solop_novo_turno")
  internalizacaoNovaEmpresa Empresa?                  @relation(fields: [internalizacaoNovaIdEmpresa], references: [idEmpresa], onUpdate: NoAction, map: "fk_solop_internalizacao_empresa")
  solicitante       User                              @relation("SolicitacaoOperacionalSolicitante", fields: [solicitanteUserId], references: [id], map: "fk_solop_solicitante")
  decididoPor       User?                             @relation("SolicitacaoOperacionalDecisor", fields: [decididoPorUserId], references: [id], map: "fk_solop_decisor")
  primeiraAprovacaoPor User?                           @relation("SolicitacaoOperacionalPrimeiraAprovacao", fields: [primeiraAprovacaoPorUserId], references: [id], map: "fk_solop_primeira_aprovacao")
  historico    SolicitacaoOperacionalHistorico[]

  @@index([tipo], map: "idx_solop_tipo")
  @@index([status], map: "idx_solop_status")
  @@index([data], map: "idx_solop_data")
  @@index([opsId], map: "idx_solop_ops_id")
  @@index([opsId2], map: "idx_solop_ops_id_2")
  @@index([novoLiderOpsId], map: "idx_solop_novo_lider")
  @@index([novaIdEscala], map: "idx_solop_nova_escala")
  @@index([novoIdTurno], map: "idx_solop_novo_turno")
  @@index([internalizacaoNovaIdEmpresa], map: "idx_solop_internalizacao_empresa")
  @@index([solicitanteUserId], map: "idx_solop_solicitante")
  @@map("solicitacao_operacional")
}

model SolicitacaoOperacionalHistorico {
  idHistorico   Int                    @id @default(autoincrement()) @map("id_historico")
  idSolicitacao Int                    @map("id_solicitacao")
  evento        String                 @db.VarChar(500)
  criadoEm      DateTime               @default(now()) @map("criado_em") @db.Timestamp(6)
  solicitacao   SolicitacaoOperacional @relation(fields: [idSolicitacao], references: [idSolicitacao], onDelete: Cascade, map: "fk_soh_solicitacao")

  @@index([idSolicitacao], map: "idx_soh_solicitacao")
  @@map("solicitacao_operacional_historico")
}

model DwPlanejado {
